APP_NAME=HMNotify
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hmnotify.24hm.net
APP_TIMEZONE=America/Guayaquil
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=info

# HMNotify NO conecta directo a BDs de negocio (todo pasa por HMSrvAuth).
# Esta conexion solo sirve si decides usar SESSION_DRIVER=database.
DB_CONNECTION=sqlite

# Session (defaults para file driver; usar redis si hay varios servidores)
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache
CACHE_STORE=file
CACHE_PREFIX=hmnotify_cache_

# Filesystems
FILESYSTEM_DISK=local

# Upload maximo (KB) para imagenes y HTML del wizard v2
UPLOAD_MAX_KB=2048

# ============================================================
# SSO - HMSrvAuth (auth.24hm.net)
# ============================================================
# Credenciales del OAuth client creado con:
#   php artisan passport:client --redirect_uri="https://hmnotify.24hm.net/auth/callback" --name="HMNotify"
# en HMSrvAuth (EC) y replicadas a PE/CO/CL via passport_client_hmnotify.sql.
CORE_SSO_BASE_URI=https://auth.24hm.net
CORE_SSO_CLIENT_ID=
CORE_SSO_CLIENT_SECRET=
CORE_SSO_REDIRECT_URI=https://hmnotify.24hm.net/auth/callback

# ============================================================
# APPS - mapping IdAplicacion (core SSO) -> {local, name, color}
# ============================================================
# Fuente de verdad: config/apps.php de HMSrvAuth.
# Usado por AppSelectController y los layouts para resolver nombre/color
# a partir del IdAplicacion que retorna spNT_UsuarioAppsNotify.
# NOTA: los values de "local" corresponden a IdAplicacionLocal en BD.
APPS='{"14":{"local":1,"name":"HMMOVIL","color":"#E62932"},"23":{"local":2,"name":"HUNTERGPS","color":"#0033A0"},"20":{"local":3,"name":"MARESA","color":"#E66E29"},"55":{"local":24,"name":"ALIVO","color":"#792F90"},"57":{"local":25,"name":"ANDORLINK","color":"#08112E"},"62":{"local":27,"name":"INKA","color":"#273767"}}'
